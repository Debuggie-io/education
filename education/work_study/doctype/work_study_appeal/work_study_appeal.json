{
  "name": "Work Study Appeal",
  "module": "Work Study",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "WSAP-.YYYY.-.#####",
  "is_submittable": 1,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "work_study_application",
      "fieldtype": "Link",
      "label": "Work Study Application",
      "options": "Work Study Application",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "student",
      "fieldtype": "Link",
      "label": "Student",
      "options": "Student",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "student_name",
      "fieldtype": "Data",
      "label": "Student Name",
      "fetch_from": "student.student_name",
      "read_only": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "appeal_date",
      "fieldtype": "Date",
      "label": "Appeal Date",
      "default": "Today",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Pending Review\nUnder Review\nApproved\nRejected",
      "default": "Pending Review",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "section_original",
      "fieldtype": "Section Break",
      "label": "Original Application Details"
    },
    {
      "fieldname": "original_rejection_reason",
      "fieldtype": "Small Text",
      "label": "Original Rejection Reason",
      "read_only": 1
    },
    {
      "fieldname": "original_screening_notes",
      "fieldtype": "Small Text",
      "label": "Original Screening Notes",
      "read_only": 1
    },
    {
      "fieldname": "section_appeal",
      "fieldtype": "Section Break",
      "label": "Appeal Details"
    },
    {
      "fieldname": "appeal_reason",
      "fieldtype": "Text Editor",
      "label": "Reason for Appeal",
      "reqd": 1
    },
    {
      "fieldname": "supporting_documents",
      "fieldtype": "Attach",
      "label": "Supporting Documents"
    },
    {
      "fieldname": "additional_information",
      "fieldtype": "Text Editor",
      "label": "Additional Information"
    },
    {
      "fieldname": "section_review",
      "fieldtype": "Section Break",
      "label": "Review"
    },
    {
      "fieldname": "reviewed_by",
      "fieldtype": "Link",
      "label": "Reviewed By",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "review_date",
      "fieldtype": "Date",
      "label": "Review Date",
      "read_only": 1
    },
    {
      "fieldname": "column_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "review_comments",
      "fieldtype": "Text Editor",
      "label": "Review Comments"
    },
    {
      "fieldname": "override_eligibility",
      "fieldtype": "Check",
      "label": "Override Eligibility Requirements",
      "description": "Allow application despite not meeting criteria"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    },
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1
    },
    {
      "role": "HR User",
      "read": 1,
      "write": 1
    },
    {
      "role": "Student",
      "read": 1,
      "write": 1,
      "create": 1,
      "if_owner": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}