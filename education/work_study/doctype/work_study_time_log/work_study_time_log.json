{
  "name": "Work Study Time Log",
  "module": "Work Study",
  "doctype": "DocType",
  "engine": "InnoDB",
  "istable": 1,
  "editable_grid": 1,
  "track_changes": 0,
  "fields": [
    {
      "fieldname": "date",
      "fieldtype": "Date",
      "label": "Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "start_time",
      "fieldtype": "Time",
      "label": "Start Time",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "end_time",
      "fieldtype": "Time",
      "label": "End Time",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "hours",
      "fieldtype": "Float",
      "label": "Hours",
      "read_only": 1,
      "in_list_view": 1,
      "precision": 2
    },
    {
      "fieldname": "task_description",
      "fieldtype": "Small Text",
      "label": "Task Description",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes"
    }
  ]
}