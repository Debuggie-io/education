{
  "name": "Work Study Assignment",
  "module": "Work Study",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "WSASGN-.YYYY.-.#####",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "student",
      "fieldtype": "Link",
      "label": "Student",
      "options": "Student",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "student_name",
      "fieldtype": "Data",
      "label": "Student Name",
      "fetch_from": "student.student_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee Record",
      "options": "Employee",
      "reqd": 1,
      "description": "Linked Employee record for HR/Payroll"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "work_study_position",
      "fieldtype": "Link",
      "label": "Work Study Position",
      "options": "Work Study Position",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "work_study_application",
      "fieldtype": "Link",
      "label": "Source Application",
      "options": "Work Study Application",
      "read_only": 1
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Department",
      "fetch_from": "work_study_position.department",
      "read_only": 1
    },
    {
      "fieldname": "section_supervisor",
      "fieldtype": "Section Break",
      "label": "Supervision"
    },
    {
      "fieldname": "supervisor",
      "fieldtype": "Link",
      "label": "Supervisor",
      "options": "Employee",
      "fetch_from": "work_study_position.supervisor"
    },
    {
      "fieldname": "supervisor_user",
      "fieldtype": "Link",
      "label": "Supervisor User",
      "options": "User",
      "fetch_from": "supervisor.user_id",
      "read_only": 1
    },
    {
      "fieldname": "column_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "hod",
      "fieldtype": "Link",
      "label": "Head of Department",
      "options": "Employee",
      "fetch_from": "work_study_position.hod"
    },
    {
      "fieldname": "section_period",
      "fieldtype": "Section Break",
      "label": "Assignment Period"
    },
    {
      "fieldname": "start_date",
      "fieldtype": "Date",
      "label": "Start Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "end_date",
      "fieldtype": "Date",
      "label": "End Date"
    },
    {
      "fieldname": "academic_year",
      "fieldtype": "Link",
      "label": "Academic Year",
      "options": "Academic Year",
      "fetch_from": "work_study_position.academic_year"
    },
    {
      "fieldname": "academic_term",
      "fieldtype": "Link",
      "label": "Academic Term",
      "options": "Academic Term",
      "fetch_from": "work_study_position.academic_term"
    },
    {
      "fieldname": "column_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Active\nOn Leave\nSuspended\nTerminated\nCompleted",
      "default": "Active",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "termination_reason",
      "fieldtype": "Small Text",
      "label": "Termination Reason",
      "depends_on": "eval:doc.status=='Terminated'"
    },
    {
      "fieldname": "section_compensation",
      "fieldtype": "Section Break",
      "label": "Compensation"
    },
    {
      "fieldname": "hourly_rate",
      "fieldtype": "Currency",
      "label": "Hourly Rate",
      "fetch_from": "work_study_position.hourly_rate"
    },
    {
      "fieldname": "max_hours_per_week",
      "fieldtype": "Int",
      "label": "Max Hours Per Week",
      "fetch_from": "work_study_position.max_hours_per_week"
    },
    {
      "fieldname": "max_hours_per_semester",
      "fieldtype": "Int",
      "label": "Max Hours Per Semester",
      "fetch_from": "work_study_position.max_hours_per_semester"
    },
    {
      "fieldname": "column_break_4",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "total_hours_worked",
      "fieldtype": "Float",
      "label": "Total Hours Worked",
      "read_only": 1,
      "precision": 2
    },
    {
      "fieldname": "total_earnings",
      "fieldtype": "Currency",
      "label": "Total Earnings",
      "read_only": 1
    },
    {
      "fieldname": "section_wallet",
      "fieldtype": "Section Break",
      "label": "Wallet Integration"
    },
    {
      "fieldname": "wallet_account",
      "fieldtype": "Link",
      "label": "Student Wallet Account",
      "options": "Account",
      "description": "Chapa360 wallet liability account"
    },
    {
      "fieldname": "total_wallet_credits",
      "fieldtype": "Currency",
      "label": "Total Wallet Credits",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "HR User",
      "read": 1,
      "write": 1
    },
    {
      "role": "Employee",
      "read": 1
    },
    {
      "role": "Student",
      "read": 1,
      "if_owner": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}