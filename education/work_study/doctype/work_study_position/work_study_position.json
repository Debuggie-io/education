{
  "name": "Work Study Position",
  "module": "Work Study",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:position_title",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "position_title",
      "fieldtype": "Data",
      "label": "Position Title",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Department",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "supervisor",
      "fieldtype": "Link",
      "label": "Supervisor",
      "options": "Employee",
      "reqd": 1
    },
    {
      "fieldname": "hod",
      "fieldtype": "Link",
      "label": "Head of Department",
      "options": "Employee"
    },
    {
      "fieldname": "section_details",
      "fieldtype": "Section Break",
      "label": "Position Details"
    },
    {
      "fieldname": "description",
      "fieldtype": "Text Editor",
      "label": "Job Description"
    },
    {
      "fieldname": "duties",
      "fieldtype": "Text Editor",
      "label": "Duties & Responsibilities"
    },
    {
      "fieldname": "column_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "requirements",
      "fieldtype": "Text Editor",
      "label": "Requirements"
    },
    {
      "fieldname": "skills_needed",
      "fieldtype": "Small Text",
      "label": "Skills Needed"
    },
    {
      "fieldname": "section_slots",
      "fieldtype": "Section Break",
      "label": "Slots & Compensation"
    },
    {
      "fieldname": "total_slots",
      "fieldtype": "Int",
      "label": "Total Slots",
      "reqd": 1,
      "default": 1
    },
    {
      "fieldname": "filled_slots",
      "fieldtype": "Int",
      "label": "Filled Slots",
      "read_only": 1,
      "default": 0
    },
    {
      "fieldname": "available_slots",
      "fieldtype": "Int",
      "label": "Available Slots",
      "read_only": 1,
      "default": 1
    },
    {
      "fieldname": "column_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "hourly_rate",
      "fieldtype": "Currency",
      "label": "Hourly Rate",
      "reqd": 1
    },
    {
      "fieldname": "max_hours_per_week",
      "fieldtype": "Int",
      "label": "Max Hours Per Week",
      "default": 20
    },
    {
      "fieldname": "max_hours_per_semester",
      "fieldtype": "Int",
      "label": "Max Hours Per Semester",
      "default": 200
    },
    {
      "fieldname": "section_eligibility",
      "fieldtype": "Section Break",
      "label": "Eligibility Criteria"
    },
    {
      "fieldname": "minimum_gpa",
      "fieldtype": "Float",
      "label": "Minimum GPA Required",
      "default": 2.0,
      "precision": 2
    },
    {
      "fieldname": "minimum_financial_need_score",
      "fieldtype": "Float",
      "label": "Minimum Financial Need Score",
      "description": "Based on outstanding balance ratio (0-100)",
      "default": 0
    },
    {
      "fieldname": "column_break_4",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "eligible_programs",
      "fieldtype": "Table MultiSelect",
      "label": "Eligible Programs",
      "options": "Work Study Eligible Program"
    },
    {
      "fieldname": "eligible_year_of_study",
      "fieldtype": "Select",
      "label": "Minimum Year of Study",
      "options": "\n1\n2\n3\n4\n5",
      "default": "1"
    },
    {
      "fieldname": "section_period",
      "fieldtype": "Section Break",
      "label": "Application Period"
    },
    {
      "fieldname": "academic_year",
      "fieldtype": "Link",
      "label": "Academic Year",
      "options": "Academic Year",
      "reqd": 1
    },
    {
      "fieldname": "academic_term",
      "fieldtype": "Link",
      "label": "Academic Term",
      "options": "Academic Term"
    },
    {
      "fieldname": "column_break_5",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "application_start_date",
      "fieldtype": "Date",
      "label": "Application Start Date"
    },
    {
      "fieldname": "application_end_date",
      "fieldtype": "Date",
      "label": "Application End Date"
    },
    {
      "fieldname": "section_status",
      "fieldtype": "Section Break",
      "label": "Status"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nOpen\nClosed\nFilled\nCancelled",
      "default": "Draft",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "published",
      "fieldtype": "Check",
      "label": "Published",
      "description": "Make visible to students"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "HR User",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Employee",
      "read": 1
    },
    {
      "role": "Student",
      "read": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}